/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Program"
    BEGIN
        MENUITEM "&Program settings",           ID_SETTINGS_PROGRAMSETTINGS
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Chain"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM "Save As (JSO&N)...",          ID_FILE_SAVE_AS_JSON
        MENUITEM SEPARATOR
        MENUITEM "&Import (FreeCAD .fcm)...",   ID_FILE_IMPORT_FCM
        MENUITEM "&Export (FreeCAD .fcm)...",   ID_FILE_EXPORT_FCM
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Properties\tCtrl+P",         ID_CHAIN_PROPERTIES
    END
    POPUP "&3DView"
    BEGIN
        POPUP "Show/Hide"
        BEGIN
            MENUITEM "Material",                    ID_SHOW_MATERIAL
            MENUITEM "Material contour",            ID_SHOW_MATERIAL_CONTOUR
            MENUITEM "Material frame",              ID_SHOW_MATERIAL_FRAME
            MENUITEM "Material holder",             ID_SHOW_MATERIAL_HOLDER
            MENUITEM "Tool",                        ID_SHOW_TOOL
            MENUITEM "Tool bounding box",           ID_SHOW_TOOL_BOUNDING_BOX

            MENUITEM "Tool frame",                  ID_SHOW_TOOL_FRAME
            MENUITEM "Tool trajectory",             ID_SHOW_TOOL_TRAJECTORY
            MENUITEM "Links",                       ID_SHOW_LINKS
            MENUITEM "Links frames",                ID_SHOW_LINKS_FRAMES
            MENUITEM "Links parts",                 ID_SHOW_LINKS_PARTS
            MENUITEM "Base",                        ID_SHOW_BASE
            MENUITEM "Base frame",                  ID_SHOW_BASE_FRAME
        END
        MENUITEM SEPARATOR
        MENUITEM "&Fixed material frame",       ID_3DVIEW_FIXED_MATERIAL_FRAME

        MENUITEM SEPARATOR
        MENUITEM "Zoom &In\tCtrl +",            ID_3DVIEW_ZOOM_IN
        MENUITEM "Zoom O&ut\tCtrl -",           ID_3DVIEW_ZOOM_OUT
        MENUITEM "Ori&ginal Size\tCtrl /",      ID_3DVIEW_ORIGINAL_SCALE
        MENUITEM "Optimal &size",               ID_3DVIEW_OPTIMAL_SIZE
        MENUITEM SEPARATOR
        MENUITEM "Initial &Position\tCtrl+Shift+R", 
                                                ID_3DVIEW_ORIGINAL_POSITION
        MENUITEM "Initial &Orienation\tCtrl+Altt+R", 
                                                ID_3DVIEW_ORIGINAL_ORIENATION

        MENUITEM "Reset &View\tCtrl+R",         ID_3DVIEW_ORIGINAL_VIEW
        MENUITEM SEPARATOR
        MENUITEM "Orthogonal projection",       ID_3DVIEW_ORTHOGONAL_PROJECTION

        MENUITEM "Perspective projection",      ID_3DVIEW_PERSPECTIVE_PROJECTION

    END
    POPUP "P&ostprocessor"
    BEGIN
        MENUITEM "&Single input",               ID_POSTPROCESSOR_SINGLEINPUT
        MENUITEM "&CL Data file",               ID_POSTPROCESSOR_CLDATAFILE
    END
    POPUP "&Simulation"
    BEGIN
        MENUITEM "&Material block",             ID_MATERIALBLOCK_GENERATEINITIALBLOCK

        MENUITEM "Milling &tool",               ID_SIMULATION_SETUPMILLINGTOOL

        MENUITEM "Simulation &dialog",          ID_SIMULATION_DIALOG
        MENUITEM "Simple simulation (&hemisphere)", ID_SIMULATION_SIMPLE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About kin5axChainEditorPlus...", 
                                                ID_APP_ABOUT
    END
END


